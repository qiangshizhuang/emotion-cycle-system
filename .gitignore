# ---- 数据缓存：运行时可重建，不进仓库 ----
data/cache/

# ---- 内置数据快照：故意提交 ----
# 这是一份截至打包日的全市场日线，随 exe 一起分发，让用户首次运行免下载。
# 72MB 在 GitHub 单文件 100MB 限制内；不进仓库就没法在云端打包时塞进包里。
!data_seed/
!data_seed/*.parquet
!data_seed/*.csv

# ---- 报告产物：每次运行都会重新生成 ----
reports/

# ---- 打包中间产物 ----
build/
dist/
build_test/
*.spec.bak

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---- 系统 ----
.DS_Store
Thumbs.db
desktop.ini
