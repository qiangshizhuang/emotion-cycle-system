# ---- 数据缓存：运行时可重建，不进仓库 ----
data/cache/

# ---- 内置数据快照：不进 git，改放 Release 资产 ----
# 72MB 的 parquet 走 git push 会在大文件传输阶段断连（实测 135 秒超时），
# 而 uploads.github.com 通道稳定。所以数据放 data-seed 这个 Release，
# 云端打包时由 workflow 自动下载。本地用 tools/make_seed.py 生成。
data_seed/

# ---- 报告产物：每次运行都会重新生成 ----
reports/

# ---- 打包中间产物 ----
build/
dist/
build_test/
*.spec.bak

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---- 系统 ----
.DS_Store
Thumbs.db
desktop.ini
